# Database (PostgreSQL URL)
DATABASE_URL="postgresql://username:password@localhost:5432/najhum_db?schema=public"

# Admin Authentication
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your-secure-password"

# JWT Secret (minimum 32 characters)
JWT_SECRET="your-random-32-character-secret-key-here"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage Provider: 'r2' | 'aws-s3' | 'vercel-blob'
STORAGE_PROVIDER="vercel-blob"

# Option A: Vercel Blob
BLOB_READ_WRITE_TOKEN="mock-token-for-local-testing"

# Option B: Cloudflare R2 (Required if STORAGE_PROVIDER="r2")
# R2_ACCOUNT_ID="your-r2-account-id"
# R2_ACCESS_KEY_ID="your-r2-access-key-id"
# R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# R2_BUCKET_NAME="your-bucket-name"
# R2_PUBLIC_URL="https://your-bucket.r2.cloudflarestorage.com"

# Option C: AWS S3 (Required if STORAGE_PROVIDER="aws-s3")
# AWS_ACCESS_KEY_ID="your-aws-access-key-id"
# AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET="your-s3-bucket-name"

# Twilio OTP (Optional - mocked if not provided)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_VERIFY_SERVICE_SID=""
