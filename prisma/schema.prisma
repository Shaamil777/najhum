generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Solution {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  metaDescription String?
  coverImage      String?
  isDraft         Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  platforms       String[]  @default([])
  classification  SolutionClassification @default(INDUSTRY)
  images          Image[]
  sections        Section[]

  @@index([slug])
  @@index([isDraft])
}

model Section {
  id         String      @id @default(cuid())
  solutionId String
  type       SectionType
  order      Int
  isDraft    Boolean     @default(false)
  content    Json
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  solution   Solution    @relation(fields: [solutionId], references: [id], onDelete: Cascade)

  @@index([solutionId, order])
  @@index([solutionId, isDraft])
}

model Image {
  id         String   @id @default(cuid())
  solutionId String
  url        String
  altText    String?
  storageKey String
  createdAt  DateTime @default(now())
  solution   Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)

  @@index([solutionId])
}

model PageContent {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  content         Json
  updatedAt       DateTime @updatedAt
  metaDescription String?
  metaTitle       String?
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  imageUrl    String?
  features    Json?
  details     Json?
  platforms   String[]
  isDraft     Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  solutions   String[]
  brochureUrl String?
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  phone       String
  email       String?
  productName String?
  brochureUrl String?
  source      String   @default("brochure_download")
  verified    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phone])
  @@index([createdAt])
}

enum SolutionClassification {
  INDUSTRY
  USE_CASE
  BOTH
}

enum SectionType {
  HERO
  INTRO
  CHALLENGE
  FEATURES
  BENEFITS
  TESTIMONIALS
  CTA
  CUSTOM
  USE_CASES
  METHODOLOGY
  SOLAAS
  PRODUCTS_CAROUSEL
  IMAGE
  VIDEO
  GRAPH
  COMPARISON_TABLE
  PRODUCT_CARD
}


model BlogPost {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  excerpt        String   @default("")
  content        String   @default("")
  category       String   @default("Insights")
  author         String   @default("Najhum Editorial")
  coverImage     String   @default("")
  coverAlt       String   @default("")
  seoTitle       String   @default("")
  seoDescription String   @default("")
  ogImage        String   @default("")
  tags           String[] @default([])
  noIndex        Boolean  @default(false)
  featured       Boolean  @default(false)
  isDraft        Boolean  @default(true)
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isDraft, publishedAt])
}

model BlogSettings {
  id             String  @id @default("main")
  heading        String  @default("Ideas for a connected world.")
  introduction   String  @default("Perspectives on technology, infrastructure, and the systems that bring them together.")
  seoTitle       String  @default("Journal | Najhum Technologies")
  seoDescription String  @default("Explore insights on industrial IoT, EV charging, smart buildings, and precision agriculture from Najhum Technologies.")
  ogImage        String  @default("")
  noIndex        Boolean @default(false)
}
